#!/usr/bin/env bash
set -euo pipefail

slug="$(printf '%s' "$HOME" | sed 's:^/::; s:/:-:g')"
dir="$HOME/.claude/projects/-$slug/memory"
mkdir -p "$dir"

cat > "$dir/MEMORY.md" <<'__MEM_EOF__'
{{ template "claude-memory/MEMORY.md" . }}
__MEM_EOF__

cat > "$dir/git-control-preference.md" <<'__MEM_EOF__'
{{ template "claude-memory/git-control-preference.md" . }}
__MEM_EOF__

cat > "$dir/minimal-code-comments.md" <<'__MEM_EOF__'
{{ template "claude-memory/minimal-code-comments.md" . }}
__MEM_EOF__

echo "claude memory placed at $dir"

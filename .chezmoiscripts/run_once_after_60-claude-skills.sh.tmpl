#!/usr/bin/env bash
set -euo pipefail

lock="$HOME/.agents/.skill-lock.json"
[ -f "$lock" ] || { echo "no skill-lock; skipping skill reinstall"; exit 0; }
command -v npx >/dev/null 2>&1 || { echo "npx missing; install node before reinstalling skills" >&2; exit 1; }

jq -r '.skills | to_entries[] | "\(.key)\t\(.value.source)"' "$lock" |
while IFS=$'\t' read -r name source; do
  if [ -d "$HOME/.agents/skills/$name" ]; then
    echo "skip $name (already present)"
    continue
  fi
  echo "installing $name from $source"
  npx -y skills add "$source@$name" -g -y
done

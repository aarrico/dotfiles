#!/usr/bin/env bash
set -euo pipefail

command -v claude >/dev/null 2>&1 || { echo "claude missing; skipping plugin provisioning"; exit 0; }

for repo in obra/superpowers-marketplace AgriciDaniel/claude-obsidian pbakaus/impeccable; do
  echo "marketplace add $repo"
  claude plugin marketplace add "$repo" || true
done

for plugin in \
  superpowers@superpowers-marketplace \
  frontend-design@claude-plugins-official \
  claude-obsidian@agricidaniel-claude-obsidian \
  impeccable@impeccable; do
  echo "install $plugin"
  claude plugin install "$plugin" || true
done

{{- $isWSL := false -}}
{{- if hasKey .chezmoi.kernel "osrelease" -}}
{{-   if or (contains "microsoft" (lower .chezmoi.kernel.osrelease)) (contains "wsl" (lower .chezmoi.kernel.osrelease)) -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end -}}
{{/* Must be an absolute path, NOT .chezmoi.sourceDir — that is self-referential
     and permanently pins the config to whatever directory `chezmoi init` first
     ran in, silently stranding edits made anywhere else. */ -}}
sourceDir = {{ printf "%s/repos/dotfiles" .chezmoi.homeDir | quote }}

[data]
    isWSL = {{ $isWSL }}

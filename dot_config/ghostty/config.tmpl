# colors come from .chezmoidata/colors.toml — edit there, not here.

# theme
background = {{ .colors.bg }}
foreground = {{ .colors.fg }}
cursor-color = {{ .colors.cursor }}
cursor-text = {{ .colors.bg }}
selection-background = {{ .colors.selection }}
selection-foreground = {{ .colors.fg }}

# 16-color ANSI — brights 9-14 intentionally mirror 1-6, matching wezterm.lua
palette = 0={{ .colors.black }}
palette = 1={{ .colors.red }}
palette = 2={{ .colors.green }}
palette = 3={{ .colors.yellow }}
palette = 4={{ .colors.blue }}
palette = 5={{ .colors.magenta }}
palette = 6={{ .colors.cyan }}
palette = 7={{ .colors.white }}
palette = 8={{ .colors.bright_black }}
palette = 9={{ .colors.red }}
palette = 10={{ .colors.green }}
palette = 11={{ .colors.yellow }}
palette = 12={{ .colors.blue }}
palette = 13={{ .colors.magenta }}
palette = 14={{ .colors.cyan }}
palette = 15={{ .colors.bright_white }}

# font — switch to "Lilex Nerd Font Mono" if icon glyphs overlap
font-family = "Hack Nerd Font Mono"
font-family = "MesloLGL Nerd Font"
font-size = 11.5

background-opacity = 1.0

window-height = 40
window-width = 150

# keybinds mirrored from wezterm.lua so muscle memory carries across machines
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
